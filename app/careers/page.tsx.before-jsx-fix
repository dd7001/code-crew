          </div>
        </section>
      )}

      {/* APPLICATION FORM */}
      <section
        className="careers-application"
        id="careers-application"
      >
        <div className="container">
          <div className="careers-application-layout">
            <Reveal>
              <div className="careers-application-info">
                <span className="eyebrow">
