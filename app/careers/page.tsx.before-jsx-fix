                </div>

                <h3>{item.title}</h3>
                <p>{item.summary}</p>
              </div>

              <button
                type="button"
                className="careers-opportunity-link"
                onClick={() => viewOpportunity(item)}
              >
                View details
              </button>
            </article>
          </Reveal>
        ))}
      </div>
    );
  }

